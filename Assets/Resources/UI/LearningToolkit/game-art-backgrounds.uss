@import url("tokens-semantics.uss");

/*
 * Static GameArt backgrounds for UI Builder preview and runtime fallback.
 * Keys match GameArtAssetKeys; runtime C# may override via ToolkitSceneBackgroundBinder.
 * resource() paths are relative to any Assets/Resources/ folder (UI/GameArt/...).
 */

.lg-scene-background-host {
    -unity-background-scale-mode: scale-and-crop;
}

/* Full-bleed scene backgrounds on root + host (root survives zero-height host in preview). */
.lg-gameart-bg--auth,
.lg-gameart-bg--auth .lg-scene-background-host {
    background-image: resource("UI/GameArt/static/navigation/backgrounds/ph-st-nav-auth-bg");
    -unity-background-scale-mode: scale-and-crop;
}

.lg-gameart-bg--mainmenu,
.lg-gameart-bg--mainmenu .lg-scene-background-host {
    background-image: resource("UI/GameArt/static/navigation/backgrounds/ph-st-nav-mainmenu-bg");
    -unity-background-scale-mode: scale-and-crop;
}

.lg-gameart-bg--leaderboard,
.lg-gameart-bg--leaderboard .lg-scene-background-host {
    background-image: resource("UI/GameArt/static/navigation/backgrounds/ph-st-nav-leaderboard-bg");
    -unity-background-scale-mode: scale-and-crop;
}

.lg-gameart-bg--chapter,
.lg-gameart-bg--chapter .lg-scene-background-host {
    background-image: resource("UI/GameArt/static/navigation/backgrounds/ph-st-nav-chapter-bg");
    -unity-background-scale-mode: scale-and-crop;
}

.lg-gameart-bg--quest,
.lg-gameart-bg--quest .lg-scene-background-host {
    background-image: resource("UI/GameArt/static/navigation/backgrounds/ph-st-nav-quest-bg");
    -unity-background-scale-mode: scale-and-crop;
}

.lg-gameart-bg--avatar-shop,
.lg-gameart-bg--avatar-shop .lg-scene-background-host {
    background-image: resource("UI/GameArt/static/navigation/backgrounds/ph-st-nav-avatar-shop-bg");
    -unity-background-scale-mode: scale-and-crop;
}

/* Auth panels */
.lg-gameart-bg--auth #login-panel {
    background-image: resource("UI/GameArt/static/navigation/backgrounds/ph-st-nav-auth-login-panel");
    -unity-background-scale-mode: scale-and-crop;
}

.lg-gameart-bg--auth #register-panel {
    background-image: resource("UI/GameArt/static/navigation/backgrounds/ph-st-nav-auth-register-panel");
    -unity-background-scale-mode: scale-and-crop;
}

/* Leaderboard refresh control */
.lg-gameart-bg--leaderboard #refresh-button {
    background-image: resource("UI/GameArt/static/navigation/buttons/ph-st-nav-refresh-btn");
    -unity-background-scale-mode: scale-to-fit;
}

/* Per-step JSON: host only (no duplicate root USS default under custom sprite) */
.lg-scene-bg-root--host-driven.lg-gameart-bg--task,
.lg-scene-bg-root--host-driven.lg-gameart-bg--cutscene {
    background-image: none;
}

/* Quest shells — root + host for UI Builder preview; runtime per-step JSON updates host only */
.lg-gameart-bg--task,
.lg-gameart-bg--task .lg-scene-background-host {
    background-image: resource("UI/GameArt/static/task-scene-backgrounds/ph-st-task-bg-default");
    -unity-background-scale-mode: scale-and-crop;
}

.lg-gameart-bg--cutscene,
.lg-gameart-bg--cutscene .lg-scene-background-host {
    background-image: resource("UI/GameArt/static/cutscene-backgrounds/ph-st-cutscene-bg-default");
    -unity-background-scale-mode: scale-and-crop;
}

/* Auth form panels: semi-transparent so panel placeholder art shows through */
.lg-gameart-bg--auth #login-panel.lg-game-panel--over-scene,
.lg-gameart-bg--auth #register-panel.lg-game-panel--over-scene {
    background-color: var(--lg-task-bg-over-scene);
}

/* Wallet HUD badge chrome */
#wallet-badge-pizza.lg-hud-badge--pizza {
    background-image: resource("UI/GameArt/static/hud/ph-st-hud-pizza-icon");
    -unity-background-scale-mode: scale-to-fit;
}

#wallet-badge-backpack.lg-hud-badge--backpack {
    background-image: resource("UI/GameArt/static/hud/ph-st-hud-backpack-icon");
    -unity-background-scale-mode: scale-to-fit;
}
