:root {
    /* Palette — readability-first warm paper × Mediterranean accents */
    --lg-cream-050: rgb(246, 244, 238);
    --lg-paper-000: rgb(239, 234, 224);
    --lg-ink-900: rgb(52, 48, 43);
    --lg-ink-700: rgb(94, 86, 78);
    --lg-ink-500: rgb(125, 115, 105);
    --lg-peach-500: rgb(255, 201, 178);
    --lg-peach-600: rgb(255, 219, 199);
    --lg-terra-450: rgb(217, 120, 86);
    --lg-terra-520: rgb(191, 95, 64);
    --lg-olive-400: rgb(146, 160, 86);
    --lg-success: rgb(73, 160, 110);
    --lg-guidance: rgb(214, 120, 60);
    --lg-attention: rgb(239, 200, 80);
    --lg-white: rgb(255, 255, 255);
    --lg-black-088: rgb(42, 40, 36);

    /* Spacing rhythm (dp, 4-based) */
    --lg-space-2: 2px;
    --lg-space-4: 4px;
    --lg-space-8: 8px;
    --lg-space-12: 12px;
    --lg-space-16: 16px;
    --lg-space-24: 24px;
    --lg-space-32: 32px;
    --lg-space-20: 20px;
    --lg-space-40: 40px;

    /* Radii */
    --lg-radius-sm: 8px;
    --lg-radius-button: 8px;
    --lg-radius-md: 14px;
    --lg-radius-lg: 22px;
    --lg-radius-pill: 999px;

    /* Hairlines */
    --lg-stroke-1: 1px;
    --lg-stroke-2: 2px;
    --lg-stroke-3: 3px;
    --lg-stroke-strong: rgb(218, 210, 198);

    /* Safe-area rhythm (logical insets; tune per device if needed later) */
    --lg-safe-inset-h: 20px;
    --lg-safe-inset-top: 16px;
    --lg-safe-inset-bottom: 20px;

    /* Bevel / inner highlight (USS has no box-shadow) */
    --lg-highlight-line: rgba(255, 255, 255, 0.55);

    /* Task difficulty surfaces */
    --lg-paper-100: rgb(229, 224, 213);
    --lg-terra-bg: rgba(217, 120, 86, 0.12);

    /* Overlays — Unity USS lacks full CSS box-shadow; cards use borders only */
    --lg-shadow-overlay: rgba(40, 38, 34, 0.45);

    /* Motion (minimal USS-only) */
    --lg-duration-fast: 0.13s;

    /* Typography sizing */
    --lg-font-display: 36px;
    --lg-font-h1: 28px;
    --lg-font-h2: 22px;
    --lg-font-body: 17px;
    --lg-font-body-lg: 19px;
    --lg-font-caption: 13px;

    --lg-line-relaxed: 1.42;
}
