/* Smartphone mockup + messenger bubbles for Special Screen SMS/WhatsApp variants */

.lg-special-screen-block-area {
    min-height: 200px;
}

.lg-special-phone {
    flex-grow: 1;
    flex-direction: column;
    align-self: center;
    width: 100%;
    max-width: 380px;
    min-height: 220px;
    padding: 10px;
    border-radius: 28px;
    border-width: 3px;
    border-color: var(--lg-border-soft);
    background-color: var(--lg-bg-muted);
}

.lg-special-phone--whatsapp .lg-special-bubble--out {
    background-color: rgba(220, 248, 198, 0.95);
}

.lg-special-phone__status {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
}

.lg-special-phone__status-time {
    font-size: 12px;
    color: var(--lg-text-soft);
    -unity-font-style: bold;
}

.lg-special-phone__status-signal {
    font-size: 11px;
    color: var(--lg-text-muted);
    -unity-text-align: middle-right;
}

.lg-special-phone__header {
    flex-shrink: 0;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--lg-border-soft);
    margin-bottom: 8px;
}

.lg-special-phone__header-title {
    font-size: 14px;
    color: var(--lg-text-main);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.lg-special-phone__scroll {
    flex-grow: 1;
}

.lg-special-chat-row {
    width: 100%;
    flex-direction: row;
    margin-bottom: 8px;
}

.lg-special-bubble--in,
.lg-special-bubble--out {
    flex-direction: column;
    max-width: 88%;
    padding: 10px;
    border-radius: 14px;
}

.lg-special-bubble--in {
    background-color: var(--lg-surface-2);
    border-width: 1px;
    border-color: var(--lg-border-soft);
}

.lg-special-bubble--out {
    background-color: var(--lg-accent-secondary-bg);
    border-width: 1px;
    border-color: var(--lg-border-soft);
}

.lg-special-bubble__author {
    font-size: 11px;
    color: var(--lg-text-muted);
    margin-bottom: 4px;
    white-space: normal;
}

.lg-special-bubble__text {
    font-size: 13px;
    color: var(--lg-text-main);
}

.lg-special-bubble__mechanic {
    flex-grow: 1;
    flex-shrink: 0;
}
