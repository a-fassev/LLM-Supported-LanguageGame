<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="NavigationPrimaryButtonPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/Navigation/Buttons/NavigationPrimaryButtonPart.uxml?fileID=9197481963319205126&amp;guid=f1a2b3c4d5e6478990ab1cd2e3f4a5b6&amp;type=3#NavigationPrimaryButtonPart" />
    <ui:Template name="NavigationSecondaryButtonPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/Navigation/Buttons/NavigationSecondaryButtonPart.uxml?fileID=9197481963319205126&amp;guid=f2b3c4d5e6f74890a1b2c3d4e5f6a7b8&amp;type=3#NavigationSecondaryButtonPart" />
    <ui:VisualElement name="root-shell" class="lg-fill-screen lg-scene-bg-root">
        <ui:VisualElement name="scene-background-host" class="lg-scene-background-host" picking-mode="Ignore" />

        <ui:VisualElement name="main-column" class="lg-shell lg-shell--full lg-fill-screen">
            <ui:VisualElement name="main-hero">
                <ui:Label text="Menu" class="lg-heading-display" />
                <ui:Label text="Continua la tua avventura linguistica" class="lg-text-body lg-text-muted"
                    style="margin-top: 8px;" />
            </ui:VisualElement>

            <ui:VisualElement name="main-spacer" class="lg-stack-flex-grow" />

            <ui:VisualElement name="main-actions" class="lg-main-actions">
                <ui:Instance template="NavigationPrimaryButtonPart" name="play-button" text="Continua"
                    class="lg-btn lg-btn--primary" />
                <ui:Instance template="NavigationSecondaryButtonPart" name="leaderboard-button" text="Classifica"
                    class="lg-btn lg-btn--secondary lg-mt-12" />
                <ui:Instance template="NavigationSecondaryButtonPart" name="logout-button" text="Esci"
                    class="lg-btn lg-btn--secondary lg-mt-12" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="overlay-plane" class="lg-overlay-root" picking-mode="Ignore" />

    </ui:VisualElement>
</ui:UXML>
