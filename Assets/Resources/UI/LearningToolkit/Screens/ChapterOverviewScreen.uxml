<!-- UI Builder: chapter overview header part (title in part); wallet in NavigationWalletHudPart. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="NavigationPageHeaderChapterOverviewPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/Navigation/NavigationPageHeaderChapterOverviewPart.uxml?fileID=9197481963319205126&amp;guid=8534ca63890744dcad17b62c6e674273&amp;type=3#NavigationPageHeaderChapterOverviewPart" />
    <ui:VisualElement name="root-shell" class="lg-fill-screen">
        <ui:VisualElement name="main-column" class="lg-shell lg-shell--full lg-fill-screen">
            <ui:Instance template="NavigationPageHeaderChapterOverviewPart" />
            <ui:ScrollView name="chapter-scroll" class="lg-list-scroll" style="margin-top: 8px;">
                <ui:Button name="chapter-row-0" class="lg-list-row-button">
                    <ui:Label name="chapter-title-0" text="Atto 1: La città" class="lg-list-row-text lg-text-body-lg lg-text-muted"/>
                    <ui:Label name="chapter-chip-0" text="" class="lg-chip lg-chip--lock" style="display: none;" />
                </ui:Button>
                <ui:Button name="chapter-row-1" class="lg-list-row-button">
                    <ui:Label name="chapter-title-1" text="Atto 2: La scuola" class="lg-list-row-text lg-text-body-lg lg-text-muted"/>
                    <ui:Label name="chapter-chip-1" text="" class="lg-chip lg-chip--lock" style="display: none;" />
                </ui:Button>
                <ui:Button name="chapter-row-2" class="lg-list-row-button">
                    <ui:Label name="chapter-title-2" text="Atto 3: Il mercato" class="lg-list-row-text lg-text-body-lg lg-text-muted"/>
                    <ui:Label name="chapter-chip-2" text="Next" class="lg-chip lg-chip--lock" style="display: flex;" />
                </ui:Button>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="overlay-plane" picking-mode="Ignore" class="lg-overlay-root"/>
    </ui:VisualElement>
</ui:UXML>
