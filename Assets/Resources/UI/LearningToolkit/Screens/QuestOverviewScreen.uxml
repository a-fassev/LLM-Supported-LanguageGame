<!-- UI Builder: quest overview header inlined (title-label runtime overwrite); wallet via components-hud.uss. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="root-shell" class="lg-fill-screen">
        <ui:VisualElement name="scene-background-host" class="lg-scene-background-host" picking-mode="Ignore" />
        <ui:VisualElement name="main-column" class="lg-shell lg-shell--full lg-fill-screen">
            <ui:VisualElement name="navigation-page-header-part" class="lg-page-header">
                <ui:VisualElement name="title-host" style="flex-grow: 1;">
                    <ui:Label name="title-label" text="Atto 1: La città" class="lg-heading-screen" />
                </ui:VisualElement>
                <ui:VisualElement name="header-actions-host" />
                <ui:VisualElement name="navigation-wallet-hud-part">
                    <ui:VisualElement name="hud-strip" class="lg-hud-strip lg-hud-strip--in-header">
                        <ui:VisualElement name="wallet-badge-pizza" class="lg-hud-badge lg-hud-badge--pizza">
                            <ui:Label name="hud-pizza-icon" text="P" class="lg-hud-badge__icon lg-hud-badge__glyph--pizza" />
                            <ui:Label name="wallet-pizza" text="0" class="lg-hud-badge__value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="wallet-badge-backpack" class="lg-hud-badge lg-hud-badge--backpack">
                            <ui:Label name="hud-backpack-icon" text="B" class="lg-hud-badge__icon lg-hud-badge__glyph--backpack" />
                            <ui:Label name="wallet-backpack" text="0" class="lg-hud-badge__value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="pause-menu-button" text="Pausa" class="lg-btn lg-btn--ghost" />
            </ui:VisualElement>
            <ui:ScrollView name="quest-scroll" class="lg-list-scroll" style="margin-top: 8px;">
                <ui:Button name="quest-row-0" class="lg-list-row-button">
                    <ui:Label name="quest-title-0" text="Missione 1: L'arrivo" class="lg-list-row-text lg-text-body-lg lg-text-muted"/>
                    <ui:Label name="quest-chip-0" text="" class="lg-chip lg-chip--lock lg-text-muted" style="display: none;" />
                </ui:Button>
                <ui:Button name="quest-row-1" class="lg-list-row-button">
                    <ui:Label name="quest-title-1" text="Missione 2: Il mercato" class="lg-list-row-text lg-text-body-lg lg-text-muted"/>
                    <ui:Label name="quest-chip-1" text="" class="lg-chip lg-chip--lock lg-text-muted" style="display: none;" />
                </ui:Button>
                <ui:Button name="quest-row-2" class="lg-list-row-button">
                    <ui:Label name="quest-title-2" text="Missione 3: La classe" class="lg-list-row-text lg-text-body-lg lg-text-muted"/>
                    <ui:Label name="quest-chip-2" text="Soon…" class="lg-chip lg-chip--lock lg-text-muted" style="display: flex;" />
                </ui:Button>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="overlay-plane" picking-mode="Ignore" class="lg-overlay-root"/>
    </ui:VisualElement>
</ui:UXML>
