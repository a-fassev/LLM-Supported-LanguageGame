<!-- UI Builder: navigation header via part instance. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="NavigationPageHeaderWithWalletPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/NavigationPageHeaderWithWalletPart.uxml?fileID=9197481963319205126&amp;guid=e7d6c5b4a3928171605f4e3d2c1b0a99&amp;type=3#NavigationPageHeaderWithWalletPart" />
    <ui:VisualElement name="root-shell" class="lg-fill-screen">
        <ui:VisualElement name="main-column" class="lg-shell lg-shell--full lg-fill-screen">
            <ui:Instance template="NavigationPageHeaderWithWalletPart">
                <ui:Label name="title-label" text="Chapter quests" class="lg-heading-display" style="margin-top: 8px;" />
            </ui:Instance>
            <ui:ScrollView name="quest-scroll" class="lg-list-scroll" style="margin-top: 8px;">
                <ui:Button name="quest-row-0" class="lg-list-row-button">
                    <ui:Label name="quest-title-0" text="" class="lg-list-row-text lg-text-body-lg lg-text-muted"/>
                    <ui:Label name="quest-chip-0" text="" class="lg-chip lg-chip--lock lg-text-muted"/>
                </ui:Button>
                <ui:Button name="quest-row-1" class="lg-list-row-button">
                    <ui:Label name="quest-title-1" text="" class="lg-list-row-text lg-text-body-lg lg-text-muted"/>
                    <ui:Label name="quest-chip-1" text="" class="lg-chip lg-chip--lock lg-text-muted"/>
                </ui:Button>
                <ui:Button name="quest-row-2" class="lg-list-row-button">
                    <ui:Label name="quest-title-2" text="" class="lg-list-row-text lg-text-body-lg lg-text-muted"/>
                    <ui:Label name="quest-chip-2" text="" class="lg-chip lg-chip--lock lg-text-muted"/>
                </ui:Button>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="overlay-plane" picking-mode="Ignore" class="lg-overlay-root"/>
    </ui:VisualElement>
</ui:UXML>
