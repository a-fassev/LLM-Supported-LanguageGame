<!-- UI Builder: part instances for preview; runtime ClearHost + ToolkitLeaderboardUx. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="LeaderboardTeamSummaryPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/Leaderboard/LeaderboardTeamSummaryPart.uxml?fileID=9197481963319205126&amp;guid=d4e5f6a7b8c94990b2c3d4e5f6071829&amp;type=3#LeaderboardTeamSummaryPart" />
    <ui:Template name="LeaderboardPlayerRowPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/Leaderboard/LeaderboardPlayerRowPart.uxml?fileID=9197481963319205126&amp;guid=04b93c554fb8c40ac8c4fab9fe2a67f4&amp;type=3#LeaderboardPlayerRowPart" />
    <ui:Template name="NavigationPageHeaderMinimalPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/Navigation/NavigationPageHeaderMinimalPart.uxml?fileID=9197481963319205126&amp;guid=38a72ed0c8fc4fe3b476f342d17cb8dc&amp;type=3#NavigationPageHeaderMinimalPart" />
    <ui:VisualElement name="root-shell" class="lg-fill-screen lg-scene-bg-root lg-gameart-bg--leaderboard">
        <ui:VisualElement name="scene-background-host" class="lg-scene-background-host" picking-mode="Ignore" />
        <ui:VisualElement name="main-column" class="lg-shell lg-shell--full lg-fill-screen--transparent lg-shell--flex-min">
            <ui:Instance template="NavigationPageHeaderMinimalPart">
                <ui:VisualElement name="header-actions-host" class="lg-header-actions-host">
                    <ui:Button name="refresh-button" text="Aggiorna"
                        class="lg-btn lg-btn--nav lg-btn--secondary" />
                    <ui:Button name="mode-overall-button" text="Generale"
                        class="lg-btn lg-btn--nav lg-btn--primary" />
                    <ui:Button name="mode-team-button" text="Squadre"
                        class="lg-btn lg-btn--nav lg-btn--secondary lg-header-actions-host__btn--trailing" />
                </ui:VisualElement>
            </ui:Instance>

            <ui:VisualElement name="team-summary-host" class="lg-stack" style="margin-top: 12px; display: none;">
                <ui:Instance template="LeaderboardTeamSummaryPart" class="lg-preview-sample">
                    <ui:VisualElement name="team-dot"
                        class="lg-leaderboard-team-dot lg-leaderboard-team-dot--visible lg-leaderboard-team-dot--blue" />
                    <ui:Label name="rank-label" text="#1" class="lg-leaderboard-player-row__rank lg-text-body-lg" />
                    <ui:Label name="team-name-label" text="Squadra Blu"
                        class="lg-leaderboard-player-row__name lg-list-row-text lg-text-body-lg" />
                    <ui:Label name="team-meta-label" text="8 giocatori"
                        class="lg-leaderboard-team-summary__meta lg-text-body lg-text-muted" />
                    <ui:Label name="pizza-wallet-value" text="42" class="lg-hud-badge__value" />
                    <ui:Label name="backpack-wallet-value" text="18" class="lg-hud-badge__value" />
                </ui:Instance>
                <ui:Instance template="LeaderboardTeamSummaryPart" class="lg-preview-sample"
                    style="margin-top: 8px;">
                    <ui:VisualElement name="team-dot"
                        class="lg-leaderboard-team-dot lg-leaderboard-team-dot--visible lg-leaderboard-team-dot--red" />
                    <ui:Label name="rank-label" text="#2" class="lg-leaderboard-player-row__rank lg-text-body-lg" />
                    <ui:Label name="team-name-label" text="Squadra Rossa"
                        class="lg-leaderboard-player-row__name lg-list-row-text lg-text-body-lg" />
                    <ui:Label name="team-meta-label" text="7 giocatori"
                        class="lg-leaderboard-team-summary__meta lg-text-body lg-text-muted" />
                    <ui:Label name="pizza-wallet-value" text="38" class="lg-hud-badge__value" />
                    <ui:Label name="backpack-wallet-value" text="14" class="lg-hud-badge__value" />
                </ui:Instance>
            </ui:VisualElement>

            <ui:VisualElement name="leaderboard-rows-panel"
                class="lg-leaderboard-rows-panel lg-game-panel lg-panel-padded lg-preview-sample">
                <ui:VisualElement name="leaderboard-scroll-host" class="lg-leaderboard-scroll-host">
                    <ui:ScrollView name="leaderboard-scroll" class="lg-list-scroll">
                        <ui:VisualElement name="leaderboard-scroll-content"
                            class="lg-leaderboard-scroll-content">
                            <ui:VisualElement name="leaderboard-list-host" class="lg-leaderboard-list-host" />
                            <ui:VisualElement name="leaderboard-ui-builder-preview"
                                class="lg-leaderboard-ui-builder-preview">
                        <ui:Instance template="LeaderboardPlayerRowPart" class="lg-preview-sample" />
                        <ui:VisualElement name="leaderboard-preview-row-2"
                            class="lg-leaderboard-player-row lg-preview-sample">
                            <ui:VisualElement name="team-dot"
                                class="lg-leaderboard-team-dot lg-leaderboard-team-dot--visible lg-leaderboard-team-dot--red" />
                            <ui:Label name="rank-label" text="#2"
                                class="lg-leaderboard-player-row__rank lg-text-body-lg" />
                            <ui:Label name="username-label" text="you"
                                class="lg-leaderboard-player-row__name lg-list-row-text lg-text-body-lg" />
                            <ui:VisualElement name="wallet-stats-host" class="lg-leaderboard-wallet-stats">
                                <ui:VisualElement name="pizza-wallet-badge"
                                    class="lg-leaderboard-wallet-badge lg-hud-badge lg-hud-badge--pizza">
                                    <ui:Label name="pizza-wallet-icon" text="P"
                                        class="lg-hud-badge__icon lg-hud-badge__glyph--pizza" />
                                    <ui:Label name="pizza-wallet-value" text="8" class="lg-hud-badge__value" />
                                </ui:VisualElement>
                                <ui:VisualElement name="backpack-wallet-badge"
                                    class="lg-leaderboard-wallet-badge lg-leaderboard-wallet-badge--trailing lg-hud-badge lg-hud-badge--backpack">
                                    <ui:Label name="backpack-wallet-icon" text="B"
                                        class="lg-hud-badge__icon lg-hud-badge__glyph--backpack" />
                                    <ui:Label name="backpack-wallet-value" text="3" class="lg-hud-badge__value" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="leaderboard-preview-row-3"
                            class="lg-leaderboard-player-row lg-preview-sample">
                            <ui:VisualElement name="team-dot"
                                class="lg-leaderboard-team-dot lg-leaderboard-team-dot--visible lg-leaderboard-team-dot--red" />
                            <ui:Label name="rank-label" text="#3"
                                class="lg-leaderboard-player-row__rank lg-text-body-lg" />
                            <ui:Label name="username-label" text="learner-beta"
                                class="lg-leaderboard-player-row__name lg-list-row-text lg-text-body-lg" />
                            <ui:VisualElement name="wallet-stats-host" class="lg-leaderboard-wallet-stats">
                                <ui:VisualElement name="pizza-wallet-badge"
                                    class="lg-leaderboard-wallet-badge lg-hud-badge lg-hud-badge--pizza">
                                    <ui:Label name="pizza-wallet-icon" text="P"
                                        class="lg-hud-badge__icon lg-hud-badge__glyph--pizza" />
                                    <ui:Label name="pizza-wallet-value" text="11" class="lg-hud-badge__value" />
                                </ui:VisualElement>
                                <ui:VisualElement name="backpack-wallet-badge"
                                    class="lg-leaderboard-wallet-badge lg-leaderboard-wallet-badge--trailing lg-hud-badge lg-hud-badge--backpack">
                                    <ui:Label name="backpack-wallet-icon" text="B"
                                        class="lg-hud-badge__icon lg-hud-badge__glyph--backpack" />
                                    <ui:Label name="backpack-wallet-value" text="2" class="lg-hud-badge__value" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label name="empty-label" text="Nessuna classifica ancora." class="lg-text-body lg-text-muted"
                style="display: none; margin-top: 16px;" />
        </ui:VisualElement>

        <ui:VisualElement name="overlay-plane" picking-mode="Ignore" class="lg-overlay-root" />
    </ui:VisualElement>
</ui:UXML>
