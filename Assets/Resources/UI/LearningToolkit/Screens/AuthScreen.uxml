<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="NavigationPrimaryButtonPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/Navigation/Buttons/NavigationPrimaryButtonPart.uxml?fileID=9197481963319205126&amp;guid=f1a2b3c4d5e6478990ab1cd2e3f4a5b6&amp;type=3#NavigationPrimaryButtonPart" />
    <ui:Template name="NavigationSecondaryButtonPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/Navigation/Buttons/NavigationSecondaryButtonPart.uxml?fileID=9197481963319205126&amp;guid=f2b3c4d5e6f74890a1b2c3d4e5f6a7b8&amp;type=3#NavigationSecondaryButtonPart" />
    <ui:VisualElement name="root-shell" class="lg-fill-screen lg-scene-bg-root">
        <ui:VisualElement name="scene-background-host" class="lg-scene-background-host" picking-mode="Ignore" />

        <ui:VisualElement name="content-plane" class="lg-shell lg-shell--form lg-fill-screen">
            <ui:Label text="Benvenuto!" class="lg-heading-display" />
            <ui:Label name="status-label" text="" class="lg-text-body lg-text-muted" />

            <ui:VisualElement name="login-panel" class="lg-game-panel lg-panel-padded">
                <ui:TextField name="login-username" label="Nome utente" class="lg-textfield" />
                <ui:TextField name="login-password" label="Password" class="lg-textfield"
                    masking-character="*" password="true" />
                <ui:Instance template="NavigationPrimaryButtonPart" name="login-button" text="Accedi"
                    class="lg-btn lg-btn--primary" />
                <ui:Button name="goto-register-button" text="Nuovo? Crea un account"
                    class="lg-btn lg-btn--ghost" />
            </ui:VisualElement>

            <ui:VisualElement name="register-panel" class="lg-game-panel lg-panel-padded" style="margin-top: 16px;">
                <ui:Label text="Scegli il tuo nome giocatore" class="lg-text-body-lg lg-text-muted" />
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
                    <ui:Label name="generated-username-label" text="..." class="lg-text-body-lg"
                        style="flex-grow: 1;" />
                    <ui:Instance template="NavigationSecondaryButtonPart" name="new-username-button"
                        text="Suggeriscine un altro" class="lg-btn lg-btn--secondary" />
                </ui:VisualElement>
                <ui:TextField name="register-password" label="Password" class="lg-textfield"
                    masking-character="*" password="true" />
                <ui:TextField name="register-password-confirm" label="Conferma password"
                    class="lg-textfield"
                    masking-character="*" password="true" />
                <ui:Instance template="NavigationPrimaryButtonPart" name="register-button" text="Crea account"
                    class="lg-btn lg-btn--primary" style="margin-top: 8px;" />
                <ui:Button name="goto-login-button" text="Ho già un account" class="lg-btn lg-btn--ghost" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="overlay-plane" picking-mode="Ignore" class="lg-overlay-root" />

    </ui:VisualElement>
</ui:UXML>
