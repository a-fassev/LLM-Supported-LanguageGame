<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="root-shell" class="lg-fill-screen">

        <ui:VisualElement name="main-column" class="lg-shell lg-shell--narrow lg-fill-screen">
            <ui:Button name="back-button" text="Back to chapters" class="lg-btn lg-btn--ghost"
                style="align-self: flex-start;" />

            <ui:Label name="chapter-title-label" text="Chapter quests"
                class="lg-heading-display" style="margin-top: 8px;" />

            <ui:ScrollView name="quest-scroll" class="lg-list-scroll" style="margin-top: 16px;">

                <ui:Button name="quest-row-0" class="lg-list-row-button">
                    <ui:Label name="quest-title-0" text=""
                        class="lg-list-row-text lg-text-body-lg lg-text-muted" />
                    <ui:Label name="quest-chip-0" text=""
                        class="lg-chip lg-chip--lock lg-text-muted" />
                </ui:Button>

                <ui:Button name="quest-row-1" class="lg-list-row-button">
                    <ui:Label name="quest-title-1" text=""
                        class="lg-list-row-text lg-text-body-lg lg-text-muted" />
                    <ui:Label name="quest-chip-1" text=""
                        class="lg-chip lg-chip--lock lg-text-muted" />
                </ui:Button>

                <ui:Button name="quest-row-2" class="lg-list-row-button">
                    <ui:Label name="quest-title-2" text=""
                        class="lg-list-row-text lg-text-body-lg lg-text-muted" />
                    <ui:Label name="quest-chip-2" text=""
                        class="lg-chip lg-chip--lock lg-text-muted" />
                </ui:Button>
            </ui:ScrollView>
        </ui:VisualElement>

        <ui:VisualElement name="overlay-plane" class="lg-overlay-root" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
