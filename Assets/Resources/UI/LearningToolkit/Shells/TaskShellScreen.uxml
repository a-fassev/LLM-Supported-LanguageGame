<!-- UI Builder: navigation header via part instance; quest title in title-label slot. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="NavigationPageHeaderWithWalletPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/NavigationPageHeaderWithWalletPart.uxml?fileID=9197481963319205126&amp;guid=e7d6c5b4a3928171605f4e3d2c1b0a99&amp;type=3#NavigationPageHeaderWithWalletPart" />
    <ui:VisualElement name="quest-root" class="lg-fill-screen">
        <ui:VisualElement name="main-column" class="lg-shell lg-shell--full lg-fill-screen">
            <ui:Instance template="NavigationPageHeaderWithWalletPart">
                <ui:Label name="title-label" text="" class="lg-heading-screen"
                    style="flex-grow: 1; -unity-text-align: middle-center; white-space: normal;" />
                <ui:VisualElement name="header-actions-host">
                    <ui:Button name="reference-document-button" text="Broschüre" class="lg-btn lg-btn--ghost"
                        style="display: none; margin-right: 4px;" />
                </ui:VisualElement>
            </ui:Instance>
            <ui:VisualElement name="quest-step-panel" class="lg-game-panel lg-quest-step-panel">
                <ui:ScrollView name="step-scroll" class="lg-list-scroll" style="flex-grow: 1; min-height: 180px;">
                    <ui:VisualElement name="step-host" style="flex-grow: 1; min-height: 160px;"/>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="quest-footer" class="lg-quest-footer" style="flex-shrink: 0; margin-top: 12px;">
                <ui:Button name="primary-action-button" text="Controlla" class="lg-btn lg-btn--primary" style="align-self: flex-end;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="overlay-plane" picking-mode="Ignore" class="lg-overlay-root"/>
    </ui:VisualElement>
</ui:UXML>
