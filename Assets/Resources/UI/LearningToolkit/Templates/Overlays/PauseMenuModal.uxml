<!-- UI Builder sample; runtime updates pause-leave label/visibility. Protected: pause-title, pause-resume, pause-leave -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="pause-menu-modal-scrim" class="lg-modal-scrim">
        <ui:VisualElement name="pause-menu-modal-card" class="lg-modal-card">
            <ui:Label name="pause-title" text="Pause"
                class="lg-heading-screen lg-modal-card__title lg-preview-sample" />
            <ui:Button name="pause-resume" text="Weiter"
                class="lg-btn lg-btn--primary lg-pause-menu__resume lg-preview-sample" />
            <ui:Button name="pause-leave" text="Zurück zu Kapiteln"
                class="lg-btn lg-btn--ghost lg-preview-sample" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
