<!-- UI Builder sample (brochure). Protected: reference-title, reference-scroll, reference-body, reference-close -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="reference-doc-modal-scrim" class="lg-modal-scrim">
        <ui:VisualElement name="reference-doc-modal-card" class="lg-modal-card lg-reference-doc-modal__card">
            <ui:Label name="reference-title" text="Guida di Bologna"
                class="lg-heading-screen lg-modal-card__title lg-modal-card__title--compact lg-preview-sample" />
            <ui:ScrollView name="reference-scroll" mode="Vertical" class="lg-reference-doc-modal__scroll">
                <ui:Label name="reference-body"
                    text="Benvenuto in città! Qui trovi parole utili per il mercato, i saluti e le domande semplici. Leggi con calma prima di iniziare la missione."
                    class="lg-text-body lg-reference-doc-modal__body lg-overlay-message-wrap lg-preview-sample" />
            </ui:ScrollView>
            <ui:Button name="reference-close" text="Schließen"
                class="lg-btn lg-btn--primary lg-preview-sample" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
