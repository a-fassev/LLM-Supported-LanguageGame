<!-- UI Builder: fixtures mirror Templates/Parts; runtime clears column hosts on Bind. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="matching-root" class="lg-muted-panel lg-task-template-root"
        style="flex-grow: 1; flex-direction: column;">
        <ui:Label name="task-prompt" text="Collega ogni elemento a sinistra con quello giusto a destra."
            class="lg-heading-screen lg-preview-sample" style="margin-bottom: 8px; white-space: normal;" />
        <ui:Label name="task-subtitle" text="Trascina una linea o tocca due carte."
            class="lg-text-body lg-text-muted lg-preview-sample" style="margin-bottom: 8px; white-space: normal;" />
        <ui:VisualElement name="matching-pairing-area"
            style="flex-grow: 1; min-height: 220px; position: relative;">
            <ui:VisualElement name="matching-columns-row"
                style="flex-grow: 1; flex-direction: row; align-items: stretch;">
                <ui:VisualElement name="matching-left-column"
                    style="flex-grow: 1; flex-basis: 0; margin-right: 8px; flex-direction: column;">
                    <ui:Label name="matching-column-header-part" text="Sinistra" class="lg-text-caption lg-preview-sample"
                        style="margin-bottom: 6px;" />
                    <ui:VisualElement name="matching-left-row-part" class="lg-preview-sample"
                        style="flex-direction: row; align-items: center; margin-bottom: 8px;">
                        <ui:VisualElement name="matching-left-card-host" style="flex-grow: 1;">
                            <ui:VisualElement name="matching-card-part" class="lg-btn lg-btn--secondary"
                                style="padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; flex-direction: column; align-items: flex-start;">
                                <ui:Label name="matching-card-label" text="Buongiorno" class="lg-text-body"
                                    style="white-space: normal;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="matching-left-row-part" class="lg-preview-sample"
                        style="flex-direction: row; align-items: center; margin-bottom: 8px;">
                        <ui:VisualElement name="matching-left-card-host" style="flex-grow: 1;">
                            <ui:VisualElement name="matching-card-part" class="lg-btn lg-btn--secondary"
                                style="padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; flex-direction: column; align-items: flex-start;">
                                <ui:Label name="matching-card-label" text="Grazie" class="lg-text-body"
                                    style="white-space: normal;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="matching-left-row-part" class="lg-preview-sample"
                        style="flex-direction: row; align-items: center; margin-bottom: 8px;">
                        <ui:VisualElement name="matching-left-card-host" style="flex-grow: 1;">
                            <ui:VisualElement name="matching-card-part" class="lg-btn lg-btn--secondary"
                                style="padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; flex-direction: column; align-items: flex-start;">
                                <ui:Label name="matching-card-label" text="Arrivederci" class="lg-text-body"
                                    style="white-space: normal;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="matching-right-column"
                    style="flex-grow: 1; flex-basis: 0; margin-left: 8px; flex-direction: column;">
                    <ui:Label name="matching-column-header-part" text="Destra" class="lg-text-caption lg-preview-sample"
                        style="margin-bottom: 6px;" />
                    <ui:VisualElement name="matching-card-part" class="lg-btn lg-btn--secondary lg-preview-sample"
                        style="margin-bottom: 8px; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; flex-direction: column; align-items: flex-start;">
                        <ui:Label name="matching-card-label" text="Good morning" class="lg-text-body"
                            style="white-space: normal;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="matching-card-part" class="lg-btn lg-btn--secondary lg-preview-sample"
                        style="margin-bottom: 8px; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; flex-direction: column; align-items: flex-start;">
                        <ui:Label name="matching-card-label" text="Thank you" class="lg-text-body"
                            style="white-space: normal;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="matching-card-part" class="lg-btn lg-btn--secondary lg-preview-sample"
                        style="margin-bottom: 8px; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; flex-direction: column; align-items: flex-start;">
                        <ui:Label name="matching-card-label" text="Goodbye" class="lg-text-body"
                            style="white-space: normal;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="matching-line-layer-host" picking-mode="Ignore"
                style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
