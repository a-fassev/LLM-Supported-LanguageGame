<!-- UI Builder: part instances for preview; runtime clears column hosts on Bind. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="MatchingColumnHeaderPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/Matching/MatchingColumnHeaderPart.uxml?fileID=9197481963319205126&amp;guid=e1a4bf1374cf747dfa7ff6d52714a3b6&amp;type=3#MatchingColumnHeaderPart" />
    <ui:Template name="MatchingLeftRowPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/Matching/MatchingLeftRowPart.uxml?fileID=9197481963319205126&amp;guid=200c3e97156544c4801fc9a6a99bf93d&amp;type=3#MatchingLeftRowPart" />
    <ui:Template name="MatchingCardPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/Matching/MatchingCardPart.uxml?fileID=9197481963319205126&amp;guid=e5a4e30071e8413494412ac08a447b74&amp;type=3#MatchingCardPart" />
    <ui:VisualElement name="matching-root" class="lg-muted-panel lg-task-template-root"
        style="flex-grow: 1; flex-direction: column;">
        <ui:Label name="task-prompt" text="Collega ogni elemento a sinistra con quello giusto a destra."
            class="lg-heading-screen lg-preview-sample" style="margin-bottom: 8px; white-space: normal;" />
        <ui:Label name="task-subtitle" text="Trascina una linea o tocca due carte."
            class="lg-text-body lg-text-muted lg-preview-sample" style="margin-bottom: 8px; white-space: normal;" />
        <ui:VisualElement name="matching-pairing-area"
            style="flex-grow: 1; min-height: 220px; position: relative;">
            <ui:VisualElement name="matching-columns-row"
                style="flex-grow: 1; flex-direction: row; align-items: stretch;">
                <ui:VisualElement name="matching-left-column"
                    style="flex-grow: 1; flex-basis: 0; margin-right: 8px; flex-direction: column;">
                    <ui:Instance template="MatchingColumnHeaderPart" />
                    <ui:Instance template="MatchingLeftRowPart">
                        <ui:VisualElement name="matching-left-card-host">
                            <ui:Instance template="MatchingCardPart">
                                <ui:Label name="matching-card-label" text="Buongiorno" />
                            </ui:Instance>
                        </ui:VisualElement>
                    </ui:Instance>
                    <ui:Instance template="MatchingLeftRowPart">
                        <ui:VisualElement name="matching-left-card-host">
                            <ui:Instance template="MatchingCardPart">
                                <ui:Label name="matching-card-label" text="Grazie" />
                            </ui:Instance>
                        </ui:VisualElement>
                    </ui:Instance>
                    <ui:Instance template="MatchingLeftRowPart">
                        <ui:VisualElement name="matching-left-card-host">
                            <ui:Instance template="MatchingCardPart">
                                <ui:Label name="matching-card-label" text="Arrivederci" />
                            </ui:Instance>
                        </ui:VisualElement>
                    </ui:Instance>
                </ui:VisualElement>
                <ui:VisualElement name="matching-right-column"
                    style="flex-grow: 1; flex-basis: 0; margin-left: 8px; flex-direction: column;">
                    <ui:Instance template="MatchingColumnHeaderPart" text="Destra" />
                    <ui:Instance template="MatchingCardPart">
                        <ui:Label name="matching-card-label" text="Good morning" />
                    </ui:Instance>
                    <ui:Instance template="MatchingCardPart">
                        <ui:Label name="matching-card-label" text="Thank you" />
                    </ui:Instance>
                    <ui:Instance template="MatchingCardPart">
                        <ui:Label name="matching-card-label" text="Goodbye" />
                    </ui:Instance>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="matching-line-layer-host" picking-mode="Ignore"
                style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
