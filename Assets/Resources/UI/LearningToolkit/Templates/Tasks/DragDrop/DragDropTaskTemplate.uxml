<!-- UI Builder: part instances for preview; runtime clears bank/targets hosts on Bind. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="DragDropCaptionPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/DragDrop/DragDropCaptionPart.uxml?fileID=9197481963319205126&amp;guid=96ac09bd1959543438c91ca0f52b91cd&amp;type=3#DragDropCaptionPart" />
    <ui:Template name="DragDropBankWrapPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/DragDrop/DragDropBankWrapPart.uxml?fileID=9197481963319205126&amp;guid=b824d93c8b5584fe98bbc31dd237f9dd&amp;type=3#DragDropBankWrapPart" />
    <ui:Template name="DragDropTargetBlockPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/DragDrop/DragDropTargetBlockPart.uxml?fileID=9197481963319205126&amp;guid=5d061df3627b41f3b4d68f7cf495c788&amp;type=3#DragDropTargetBlockPart" />
    <ui:VisualElement name="drag-drop-root" class="lg-muted-panel lg-task-template-root"
        style="flex-grow: 1; flex-direction: column; position: relative;">
        <ui:Label name="task-prompt" text="Trascina le parole nelle categorie giuste." class="lg-heading-screen lg-preview-sample"
            style="margin-bottom: 8px; white-space: normal;" />
        <ui:Label name="task-subtitle" text="Tocca una carta e trascinala nella zona corretta."
            class="lg-text-body lg-text-muted lg-preview-sample" style="margin-bottom: 8px; white-space: normal;" />
        <ui:VisualElement name="drag-drop-bank-host" style="flex-direction: column; margin-bottom: 12px;">
            <ui:Instance template="DragDropCaptionPart" />
            <ui:Instance template="DragDropBankWrapPart" />
        </ui:VisualElement>
        <ui:VisualElement name="drag-drop-targets-host" style="flex-grow: 1; flex-direction: column;">
            <ui:Instance template="DragDropCaptionPart" text="Trascina qui sotto nella categoria giusta" />
            <ui:Instance template="DragDropTargetBlockPart">
                <ui:Label name="drag-drop-target-title" text="Frutta" />
            </ui:Instance>
            <ui:Instance template="DragDropTargetBlockPart">
                <ui:Label name="drag-drop-target-title" text="Animali" />
            </ui:Instance>
        </ui:VisualElement>
        <ui:VisualElement name="drag-drop-float-layer" picking-mode="Ignore"
            style="position: absolute; left: 0; right: 0; top: 0; bottom: 0;" />
    </ui:VisualElement>
</ui:UXML>
