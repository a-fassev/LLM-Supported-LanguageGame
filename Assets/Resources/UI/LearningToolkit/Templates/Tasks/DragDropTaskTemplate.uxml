<!-- UI Builder: fixtures mirror Templates/Parts; runtime clears bank/targets hosts on Bind. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="drag-drop-root" class="lg-muted-panel lg-task-template-root"
        style="flex-grow: 1; flex-direction: column; position: relative;">
        <ui:Label name="task-prompt" text="Trascina le parole nelle categorie giuste." class="lg-heading-screen lg-preview-sample"
            style="margin-bottom: 8px; white-space: normal;" />
        <ui:Label name="task-subtitle" text="Tocca una carta e trascinala nella zona corretta."
            class="lg-text-body lg-text-muted lg-preview-sample" style="margin-bottom: 8px; white-space: normal;" />
        <ui:VisualElement name="drag-drop-bank-host" style="flex-direction: column; margin-bottom: 12px;">
            <ui:Label name="drag-drop-caption-part" text="Parole da spostare" class="lg-text-caption lg-preview-sample" />
            <ui:VisualElement name="bank-wrap" class="lg-preview-sample"
                style="flex-direction: row; flex-wrap: wrap; margin-top: 4px;">
                <ui:VisualElement name="drag-drop-tile-part" class="lg-btn lg-btn--secondary lg-preview-sample"
                    style="margin-right: 8px; margin-bottom: 8px; min-width: 80px; min-height: 44px; padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 8px; justify-content: center;">
                    <ui:Label name="drag-drop-tile-label" text="mela" class="lg-text-body" style="white-space: normal;" />
                </ui:VisualElement>
                <ui:VisualElement name="drag-drop-tile-part" class="lg-btn lg-btn--secondary lg-preview-sample"
                    style="margin-right: 8px; margin-bottom: 8px; min-width: 80px; min-height: 44px; padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 8px; justify-content: center;">
                    <ui:Label name="drag-drop-tile-label" text="cane" class="lg-text-body" style="white-space: normal;" />
                </ui:VisualElement>
                <ui:VisualElement name="drag-drop-tile-part" class="lg-btn lg-btn--secondary lg-preview-sample"
                    style="margin-right: 8px; margin-bottom: 8px; min-width: 80px; min-height: 44px; padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 8px; justify-content: center;">
                    <ui:Label name="drag-drop-tile-label" text="rosso" class="lg-text-body" style="white-space: normal;" />
                </ui:VisualElement>
                <ui:VisualElement name="drag-drop-tile-part" class="lg-btn lg-btn--secondary lg-preview-sample"
                    style="margin-right: 8px; margin-bottom: 8px; min-width: 80px; min-height: 44px; padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 8px; justify-content: center;">
                    <ui:Label name="drag-drop-tile-label" text="correre" class="lg-text-body" style="white-space: normal;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="drag-drop-targets-host" style="flex-grow: 1; flex-direction: column;">
            <ui:Label name="drag-drop-caption-part" text="Trascina qui sotto nella categoria giusta"
                class="lg-text-caption lg-preview-sample" style="margin-bottom: 6px;" />
            <ui:VisualElement name="drag-drop-target-block-part" class="lg-muted-panel lg-preview-sample"
                style="margin-bottom: 10px; padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;">
                <ui:Label name="drag-drop-target-title" text="Frutta" class="lg-text-body"
                    style="unity-font-style-and-weight: bold; margin-bottom: 6px;" />
                <ui:VisualElement name="drag-drop-drop-zone" class="lg-list-row-button" style="min-height: 100px;">
                    <ui:VisualElement name="drag-drop-drop-zone-inner-part"
                        style="flex-direction: row; flex-wrap: wrap; flex-grow: 1; min-height: 60px; align-items: center; justify-content: flex-start;">
                        <ui:Label name="drag-drop-drop-hint" text="Trascina qui" class="lg-text-muted"
                            style="unity-font-style-and-weight: italic;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="drag-drop-target-block-part" class="lg-muted-panel lg-preview-sample"
                style="margin-bottom: 10px; padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;">
                <ui:Label name="drag-drop-target-title" text="Animali" class="lg-text-body"
                    style="unity-font-style-and-weight: bold; margin-bottom: 6px;" />
                <ui:VisualElement name="drag-drop-drop-zone" class="lg-list-row-button" style="min-height: 100px;">
                    <ui:VisualElement name="drag-drop-drop-zone-inner-part"
                        style="flex-direction: row; flex-wrap: wrap; flex-grow: 1; min-height: 60px; align-items: center; justify-content: flex-start;">
                        <ui:VisualElement name="drag-drop-tile-part" class="lg-btn lg-btn--secondary"
                            style="margin-right: 8px; margin-bottom: 8px; min-width: 80px; min-height: 44px; padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 8px; justify-content: center;">
                            <ui:Label name="drag-drop-tile-label" text="cane" class="lg-text-body" style="white-space: normal;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="drag-drop-float-layer" picking-mode="Ignore"
            style="position: absolute; left: 0; right: 0; top: 0; bottom: 0;" />
    </ui:VisualElement>
</ui:UXML>
