<!-- UI Builder sample; runtime overwrites title and fills drop zone. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="drag-drop-target-block-part" class="lg-muted-panel lg-preview-sample"
        style="margin-bottom: 10px; padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px;">
        <ui:Label name="drag-drop-target-title" text="Animali" class="lg-text-body"
            style="unity-font-style-and-weight: bold; margin-bottom: 6px;" />
        <ui:VisualElement name="drag-drop-drop-zone" class="lg-list-row-button" style="min-height: 100px;">
            <ui:Label text="Trascina qui" class="lg-text-muted lg-preview-sample"
                style="unity-font-style-and-weight: italic; align-self: center;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
