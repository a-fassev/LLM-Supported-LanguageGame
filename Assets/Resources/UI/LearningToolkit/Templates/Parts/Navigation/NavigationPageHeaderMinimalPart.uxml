<!-- UI Builder: page header without wallet (e.g. Leaderboard). -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="navigation-page-header-minimal-part" class="lg-page-header">
        <ui:VisualElement name="title-host" style="flex-grow: 1;">
            <ui:Label name="title-label" text="Leaderboard" class="lg-heading-screen" />
        </ui:VisualElement>
        <ui:VisualElement name="header-actions-host" class="lg-header-actions-host" />
        <ui:Button name="pause-menu-button" text="Pause" class="lg-btn lg-btn--ghost" />
    </ui:VisualElement>
</ui:UXML>
