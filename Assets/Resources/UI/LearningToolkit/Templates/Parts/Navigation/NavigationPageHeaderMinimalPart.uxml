<!-- UI Builder: page header without wallet (e.g. Leaderboard). -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="NavigationGhostButtonPart"
        src="project://database/Assets/Resources/UI/LearningToolkit/Templates/Parts/Navigation/Buttons/NavigationGhostButtonPart.uxml?fileID=9197481963319205126&amp;guid=e4f5a6b7c8d9402a1b2c3d4e5f607193&amp;type=3#NavigationGhostButtonPart" />
    <ui:VisualElement name="navigation-page-header-part" class="lg-page-header">
