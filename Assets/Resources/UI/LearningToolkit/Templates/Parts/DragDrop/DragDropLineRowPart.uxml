<!-- UI Builder sample; runtime ClearHost then rebuilds line segments. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="drag-drop-line-row-part"
        style="flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 10px;">
        <ui:Label text="Il " class="lg-text-body lg-preview-sample"
            style="white-space: normal; margin-right: 6px;" />
        <ui:VisualElement class="lg-list-row-button lg-preview-sample"
            style="width: 96px; height: 56px; margin-right: 6px; justify-content: center; align-items: center;">
            <ui:Label text="Trascina qui" class="lg-text-muted"
                style="unity-font-style-and-weight: italic;" />
        </ui:VisualElement>
        <ui:Label text=" è nel giardino." class="lg-text-body lg-preview-sample"
            style="white-space: normal; margin-right: 6px;" />
    </ui:VisualElement>
</ui:UXML>
