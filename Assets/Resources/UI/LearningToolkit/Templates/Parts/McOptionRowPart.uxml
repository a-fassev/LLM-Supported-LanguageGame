<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="mc-option-row-part" class="lg-list-row-button"
        style="flex-direction: row; align-items: center; margin-bottom: 10px; padding-top: 8px; padding-bottom: 8px; padding-left: 8px; padding-right: 8px;">
        <ui:Toggle />
        <ui:Label name="mc-option-label" text="" class="lg-text-body"
            style="flex-grow: 1; margin-left: 8px; white-space: normal;" />
        <ui:VisualElement name="mc-option-image" style="display: none; width: 96px; height: 96px; margin-left: 8px;" />
    </ui:VisualElement>
</ui:UXML>
