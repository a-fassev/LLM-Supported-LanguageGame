<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="cutscene-thought-root" class="lg-cutscene-beat-row lg-cutscene-beat-row--playerLeft">
        <ui:VisualElement name="avatar-slot" class="lg-cutscene-avatar-slot lg-cutscene-avatar-slot--placeholder" />
        <ui:VisualElement name="bubble-col" class="lg-cutscene-bubble-col">
            <ui:VisualElement name="thought-bubble" class="lg-cutscene-thought__bubble lg-cutscene-speech-bubble lg-cutscene-speech-bubble--thought">
                <ui:VisualElement name="bubble-tail" class="lg-cutscene-speech-bubble__tail lg-cutscene-speech-bubble__tail--left" />
                <ui:Label name="beat-title" text="" class="lg-cutscene-thought__title"
                    style="display: none; white-space: normal;" />
                <ui:Label name="beat-body" text="Forse dovrei alzare la mano… ma ho un po' di paura."
                    class="lg-cutscene-thought__body lg-preview-sample" style="white-space: normal;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
