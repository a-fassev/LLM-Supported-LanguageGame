@import url("tokens-semantics.uss");

Button.lg-btn:focus {
    border-width: 2px;
    border-color: var(--lg-focus-ring);
}

Button.lg-btn {
    min-height: 48px;
    padding-left: var(--lg-space-16);
    padding-right: var(--lg-space-16);
    border-radius: var(--lg-radius-button);
    border-width: 0;
    font-size: var(--lg-font-body-lg);
    -unity-font-style: bold;
    transition-duration: var(--lg-duration-fast);
}

Button.lg-btn--primary {
    background-color: var(--lg-accent-primary-bg);
    color: var(--lg-text-soft);
}

Button.lg-btn--primary:hover {
    background-color: var(--lg-accent-primary-press) !important;
}

Button.lg-btn--primary:active {
    background-color: var(--lg-accent-primary-press) !important;
}

Button.lg-btn--primary-hard {
    background-color: var(--lg-terra-520);
    color: var(--lg-text-inverse);
}

Button.lg-btn--primary-hard:hover {
    background-color: var(--lg-terra-450);
}

Button.lg-btn--primary-hard:focus {
    border-width: 2px;
    border-color: var(--lg-focus-ring);
}

Button.lg-btn--primary-hard:active {
    background-color: var(--lg-terra-520);
}

Button.lg-btn--nav {
    min-height: 44px;
    padding-left: var(--lg-space-12);
    padding-right: var(--lg-space-12);
    background-color: rgba(43, 128, 168, 0.08);
    border-width: var(--lg-stroke-1);
    border-color: var(--lg-peach-500);
    color: var(--lg-peach-600);
    -unity-font-style: bold;
}

Button.lg-btn--nav:hover {
    background-color: rgba(43, 128, 168, 0.14);
}

Button.lg-btn--secondary {
    background-color: var(--lg-accent-secondary-bg);
    border-width: var(--lg-stroke-1);
    border-color: var(--lg-border-soft);
    color: var(--lg-text-main);
}

Button.lg-btn--ghost {
    background-color: transparent;
    color: var(--lg-peach-600);
    border-width: 0;
}

Button.lg-btn--ghost#pause-menu-button {
    border-width: var(--lg-stroke-1);
    border-color: var(--lg-border-soft);
}

Button.lg-btn--ghost#pause-menu-button:hover {
    background-color: rgba(43, 128, 168, 0.08);
    border-color: var(--lg-peach-500);
}

Button.lg-btn--tertiary {
    background-color: transparent;
    color: var(--lg-terra-520);
    min-height: 40px;
    border-width: 0;
}

TextField.lg-textfield {
    min-height: 48px;
    margin-bottom: var(--lg-space-8);
}

TextField.lg-textfield > Label {
    min-width: 120px;
    color: var(--lg-text-inverse);
}

TextField.lg-error-spotting-inline-field > Label {
    display: none;
    min-width: 0;
    width: 0;
    margin: 0;
    padding: 0;
}

TextField.lg-cloze-gap-inline {
    min-height: 32px;
    margin-bottom: 0;
}

TextField.lg-cloze-gap-inline > Label {
    display: none;
    min-width: 0;
    width: 0;
    margin: 0;
    padding: 0;
}

TextField.lg-textfield > TextInput {
    background-color: rgba(255, 201, 178, 0.4);
    border-radius: var(--lg-radius-sm);
    border-width: var(--lg-stroke-1);
    border-color: var(--lg-border-soft);
    padding-left: var(--lg-space-12);
    padding-right: var(--lg-space-12);
}

TextField.lg-textfield:focus > TextInput {
    border-color: var(--lg-focus-ring);
}
