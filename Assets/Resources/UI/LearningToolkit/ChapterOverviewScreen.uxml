<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="root-shell" class="lg-fill-screen">
        <ui:VisualElement name="main-column" class="lg-shell lg-shell--full lg-fill-screen">
            <ui:VisualElement class="lg-page-header">
                <ui:VisualElement style="flex-grow: 1; align-items: center;">
                    <ui:Label name="title-label" text="Choose a chapter" class="lg-heading-screen" style="align-self: flex-start;"/>
                </ui:VisualElement>
                <ui:VisualElement name="hud-strip" class="lg-hud-strip" style="padding-bottom: 0;">
                    <ui:VisualElement name="wallet-badge-pizza" class="lg-hud-badge lg-hud-badge--pizza">
                        <ui:Label name="hud-pizza-icon" text="P" class="lg-hud-badge__icon lg-hud-badge__glyph--pizza"/>
                        <ui:Label name="wallet-pizza" text="?" class="lg-hud-badge__value"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="wallet-badge-backpack" class="lg-hud-badge lg-hud-badge--backpack">
                        <ui:Label name="hud-backpack-icon" text="B" class="lg-hud-badge__icon lg-hud-badge__glyph--backpack"/>
                        <ui:Label name="wallet-backpack" text="?" class="lg-hud-badge__value"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="avatar-shop-button" text="Avatar" class="lg-btn lg-btn--secondary" style="margin-right: 8px;"/>
                <ui:Button name="pause-menu-button" text="Pause" class="lg-btn lg-btn--ghost"/>
            </ui:VisualElement>
            <ui:ScrollView name="chapter-scroll" class="lg-list-scroll" style="margin-top: 8px;">
                <ui:Button name="chapter-row-0" class="lg-list-row-button">
                    <ui:Label name="chapter-title-0" text="" class="lg-list-row-text lg-text-body-lg lg-text-muted"/>
                    <ui:Label name="chapter-chip-0" text="" class="lg-chip lg-chip--lock"/>
                </ui:Button>
                <ui:Button name="chapter-row-1" class="lg-list-row-button">
                    <ui:Label name="chapter-title-1" text="" class="lg-list-row-text lg-text-body-lg lg-text-muted"/>
                    <ui:Label name="chapter-chip-1" text="" class="lg-chip lg-chip--lock"/>
                </ui:Button>
                <ui:Button name="chapter-row-2" class="lg-list-row-button">
                    <ui:Label name="chapter-title-2" text="" class="lg-list-row-text lg-text-body-lg lg-text-muted"/>
                    <ui:Label name="chapter-chip-2" text="" class="lg-chip lg-chip--lock"/>
                </ui:Button>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="overlay-plane" picking-mode="Ignore" class="lg-overlay-root"/>
    </ui:VisualElement>
</ui:UXML>
