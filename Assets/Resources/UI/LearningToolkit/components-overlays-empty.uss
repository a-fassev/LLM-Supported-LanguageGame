@import url("tokens-semantics.uss");

/* UI Builder fixture marker (Option B); no required runtime styling. */
.lg-preview-sample {
}

.lg-error-banner {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 96px;
    padding: var(--lg-space-12) var(--lg-space-24) var(--lg-safe-inset-bottom) var(--lg-space-24);
    background-color: var(--lg-feedback-guidance-bg);
    border-top-left-radius: var(--lg-radius-md);
    border-top-right-radius: var(--lg-radius-md);
    border-top-width: var(--lg-stroke-2);
    border-color: var(--lg-guidance);
    flex-direction: row;
    justify-content: space-between;
}

.lg-banner-message {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: var(--lg-space-12);
}

.lg-loading-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--lg-shadow-overlay);
    justify-content: center;
    align-items: center;
}

.lg-loading-card {
    min-width: 320px;
    max-width: 480px;
    padding: var(--lg-space-32);
    border-radius: var(--lg-radius-lg);
    background-color: var(--lg-surface-1);
    border-width: var(--lg-stroke-2);
    border-color: var(--lg-modal-border-game);
    border-top-color: var(--lg-card-highlight);
}

.lg-modal-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--lg-shadow-overlay);
    justify-content: center;
    align-items: center;
}

.lg-modal-card {
    width: 88%;
    max-width: 480px;
    padding: var(--lg-space-32);
    border-radius: var(--lg-radius-lg);
    background-color: var(--lg-surface-1);
    border-width: var(--lg-stroke-2);
    border-color: var(--lg-modal-border-game);
    border-top-color: var(--lg-card-highlight);
}

.lg-overlay-message-wrap {
    white-space: normal;
}

.lg-overlay-message-center {
    white-space: normal;
    -unity-text-align: middle-center;
}

.lg-modal-card__title {
    margin-bottom: var(--lg-space-12);
    white-space: normal;
}

.lg-modal-card__title--compact {
    margin-bottom: var(--lg-space-8);
}

.lg-modal-card__message {
    margin-bottom: var(--lg-space-16);
    white-space: normal;
}

.lg-modal-card__primary-stretch {
    align-self: stretch;
}

.lg-modal-actions-row {
    flex-direction: row;
    justify-content: flex-end;
    flex-wrap: wrap;
}

.lg-modal-actions-row--spread {
    justify-content: space-between;
}

.lg-modal-actions-row__secondary {
    margin-right: var(--lg-space-8);
}

.lg-reward-modal__headline {
    margin-bottom: var(--lg-space-12);
    -unity-text-align: middle-center;
    white-space: normal;
}

.lg-reward-modal__details {
    margin-bottom: var(--lg-space-16);
}

.lg-info-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    min-height: 96px;
    padding: var(--lg-space-12) var(--lg-space-24) var(--lg-space-12) var(--lg-space-24);
    background-color: var(--lg-feedback-guidance-bg);
    border-bottom-left-radius: var(--lg-radius-md);
    border-bottom-right-radius: var(--lg-radius-md);
    border-bottom-width: var(--lg-stroke-2);
    border-color: var(--lg-guidance);
    flex-direction: row;
    align-items: center;
}

.lg-reference-doc-modal__card {
    max-width: 520px;
}

.lg-reference-doc-modal__scroll {
    max-height: 360px;
    margin-bottom: var(--lg-space-12);
}

.lg-pause-menu__resume {
    margin-bottom: var(--lg-space-8);
}
