<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="root-shell" class="lg-fill-screen">
        <ui:VisualElement name="main-column" class="lg-shell lg-shell--narrow">
            <ui:Label text="Theme preview" class="lg-heading-display" />
            <ui:VisualElement style="flex-direction: row; flex-wrap: wrap;">
                <ui:Button text="Primary" class="lg-btn lg-btn--primary lg-btn lg-btn--primary" />
                <ui:Button text="Secondary" class="lg-btn lg-btn--secondary" style="margin-left: 12px;" />
                <ui:Button text="Ghost" class="lg-btn lg-btn--ghost" style="margin-left: 12px;" />
                <ui:Button text="Tertiary" class="lg-btn lg-btn--tertiary" style="margin-left: 12px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; margin-top: 12px;">
                <ui:Label text="bonus" class="lg-chip lg-chip--bonus lg-text-muted" />
                <ui:Label text="new" class="lg-chip lg-chip--new lg-text-muted lg-text-muted" style="margin-left: 12px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
