@import url("tokens-semantics.uss");

.lg-cutscene-root {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    justify-content: center;
}

.lg-cutscene-narrator {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 16px 20px;
    background-color: var(--lg-surface-muted);
    border-radius: var(--lg-radius-md);
}

.lg-cutscene-narrator__title {
    -unity-font-style: bold;
    font-size: var(--lg-font-size-heading);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 8px;
}

.lg-cutscene-narrator__subtitle {
    font-size: var(--lg-font-size-body);
    opacity: 0.85;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 12px;
}

.lg-cutscene-narrator__body {
    font-size: var(--lg-font-size-body);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Full-width beat row: avatar ~25% + bubble column ~75% */
.lg-cutscene-beat-row {
    flex-direction: row;
    align-items: flex-end;
    flex-grow: 1;
    width: 100%;
    min-height: 200px;
    padding: 8px 4px;
}

.lg-cutscene-beat-row--playerLeft {
    justify-content: flex-start;
}

.lg-cutscene-beat-row--npcRight {
    justify-content: flex-end;
}

.lg-cutscene-avatar-slot {
    width: 25%;
    max-width: 28%;
    min-width: 72px;
    min-height: 200px;
    flex-shrink: 0;
    align-self: stretch;
    background-size: contain;
    background-position-x: center;
    background-position-y: bottom;
    background-repeat: no-repeat;
}

.lg-cutscene-avatar-slot--placeholder {
    background-color: var(--lg-surface-muted);
    border-radius: var(--lg-radius-md);
    border-width: 2px;
    border-color: var(--lg-border-subtle);
}

.lg-cutscene-bubble-col {
    width: 75%;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    justify-content: flex-end;
}

.lg-cutscene-speech-bubble {
    position: relative;
    flex-direction: column;
    flex-shrink: 1;
}

.lg-cutscene-speech-bubble__tail {
    position: absolute;
    width: 12px;
    height: 12px;
    bottom: 22px;
    border-radius: 2px;
    background-color: var(--lg-surface-elevated);
}

.lg-cutscene-speech-bubble--thought .lg-cutscene-speech-bubble__tail {
    background-color: var(--lg-surface-muted);
}

.lg-cutscene-speech-bubble__tail--left {
    left: -4px;
}

.lg-cutscene-speech-bubble__tail--right {
    right: -4px;
}

.lg-cutscene-npc__name {
    font-size: var(--lg-font-size-caption);
    opacity: 0.9;
    margin-bottom: 4px;
}

.lg-cutscene-npc__bubble {
    background-color: var(--lg-surface-elevated);
    border-radius: var(--lg-radius-md);
    padding: 12px 20px 12px 14px;
}

.lg-cutscene-speech-bubble--speech {
    border-radius: var(--lg-radius-md);
}

.lg-cutscene-npc__body {
    white-space: normal;
}

.lg-cutscene-thought__bubble {
    background-color: var(--lg-surface-muted);
    border-radius: var(--lg-radius-lg);
    border-width: 1px;
    border-color: var(--lg-border-subtle);
    padding: 14px 16px 14px 20px;
}

.lg-cutscene-thought__title {
    -unity-font-style: bold;
    margin-bottom: 6px;
    white-space: normal;
}

.lg-cutscene-thought__body {
    -unity-font-style: italic;
    white-space: normal;
}

.lg-cutscene-gameinfo {
    flex-direction: row;
    align-items: flex-start;
    padding: 14px 16px;
    background-color: var(--lg-surface-muted);
    border-radius: var(--lg-radius-md);
    border-left-width: 4px;
    border-left-color: var(--lg-accent-primary);
}

.lg-cutscene-gameinfo__icon {
    width: 28px;
    height: 28px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    background-color: var(--lg-accent-primary);
    color: var(--lg-text-on-accent);
    border-radius: 14px;
    margin-right: 12px;
    flex-shrink: 0;
}

.lg-cutscene-gameinfo__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.lg-cutscene-gameinfo__title {
    -unity-font-style: bold;
    margin-bottom: 6px;
    white-space: normal;
}

.lg-cutscene-gameinfo__body {
    white-space: normal;
}

.lg-reference-doc-modal__body {
    white-space: normal;
    max-height: 360px;
}
