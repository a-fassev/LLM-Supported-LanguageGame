/* Magazine / book reader layouts for SpecialScreenReader */

.lg-special-screen-reader-area {
    flex-grow: 1;
    min-height: 200px;
}

.lg-special-reader-scroll {
    flex-grow: 1;
    flex-shrink: 0;
}

.lg-special-reader-panel {
    flex-shrink: 0;
    flex-direction: column;
    padding-top: 4px;
    padding-bottom: 12px;
    padding-left: 4px;
    padding-right: 4px;
}

.lg-special-reader__image {
    width: 100%;
    flex-shrink: 0;
    min-height: 120px;
    max-height: 220px;
    margin-bottom: 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--lg-border-soft);
    background-color: var(--lg-bg-muted);
    -unity-background-scale-mode: scale-to-fit;
}

.lg-special-reader__headline {
    margin-bottom: 6px;
    white-space: normal;
}

.lg-special-reader__subhead {
    margin-bottom: 12px;
    white-space: normal;
}

.lg-special-reader__columns-row {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: space-between;
    align-items: flex-start;
}

.lg-special-reader__column {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    flex-shrink: 0;
    margin-left: 4px;
    margin-right: 4px;
}

.lg-special-reader__column--first {
    margin-left: 0;
}

.lg-special-reader__column--second {
    margin-right: 0;
}

.lg-special-reader__body {
    white-space: normal;
}

/* Line-numbered excerpts */
.lg-special-reader__line-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.lg-special-reader__line-num {
    flex-shrink: 0;
    min-width: 28px;
    margin-right: 8px;
    color: var(--lg-text-soft);
    -unity-font-style: italic;
}

.lg-special-reader__line-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}
