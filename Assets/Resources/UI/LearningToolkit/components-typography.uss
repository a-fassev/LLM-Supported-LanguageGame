@import url("tokens-semantics.uss");

TextField > Label,
Label {
    color: var(--lg-text-main);
}

.lg-heading-display {
    font-size: var(--lg-font-display);
    -unity-font-style: bold;
    color: var(--lg-text-main);
    -unity-text-outline-width: 0;
}

.lg-heading-screen {
    font-size: var(--lg-font-h1);
    -unity-font-style: bold;
    letter-spacing: 0.2px;
}

.lg-text-h2 {
    font-size: var(--lg-font-h2);
}

.lg-text-body {
    font-size: var(--lg-font-body);
    white-space: normal;
}

.lg-text-body-lg {
    font-size: var(--lg-font-body-lg);
}

.lg-text-muted {
    color: var(--lg-text-soft);
}

.lg-text-caption {
    font-size: var(--lg-font-caption);
    color: var(--lg-text-muted);
}

.lg-fill-screen {
    flex-grow: 1;
    background-color: var(--lg-bg-app);
    flex-direction: column;
}

.lg-shell {
    padding-left: var(--lg-safe-inset-h);
    padding-right: var(--lg-safe-inset-h);
    padding-top: var(--lg-space-24);
    padding-bottom: var(--lg-safe-inset-bottom);
    flex-grow: 1;
}

/* Full-bleed layout for game/map/overview/task shells */
.lg-shell--full {
    align-self: stretch;
    width: 100%;
    max-width: none;
}

/* Narrow centered column for auth/forms */
.lg-shell--form {
    max-width: 440px;
    align-self: center;
    width: 100%;
}

/* Top chrome row (back + title actions) */
.lg-page-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    width: 100%;
    margin-bottom: var(--lg-space-8);
}

/* Push footer actions to bottom of a column shell */
.lg-stack-flex-grow {
    flex-grow: 1;
    min-height: var(--lg-space-16);
}

.lg-main-actions {
    flex-direction: column;
    flex-shrink: 0;
    align-self: stretch;
    margin-top: auto;
}

.lg-main-actions > Button {
    align-self: stretch;
}

.lg-mt-12 {
    margin-top: var(--lg-space-12);
}

.lg-overlay-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.lg-muted-panel {
    background-color: var(--lg-bg-muted);
    border-radius: var(--lg-radius-md);
}

/* Clickable phrase chips for ErrorSpotting (`ErrorSpottingToolkitStep`). */
.lg-error-spotting-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    white-space: normal;
    margin-top: var(--lg-space-8);
}

.lg-error-spotting-chip {
    flex-grow: 0;
    border-width: 0;
    padding-left: var(--lg-space-4);
    padding-right: var(--lg-space-4);
    padding-top: 6px;
    padding-bottom: 6px;
    margin-right: 4px;
    margin-bottom: 6px;
    border-radius: var(--lg-radius-sm);
    background-color: transparent;
    font-size: var(--lg-font-body);
    color: var(--lg-text-main);
}

.lg-error-spotting-chip:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.lg-error-spotting-chip.lg-error-spotting-chip--marked {
    background-color: rgba(255, 200, 100, 0.18);
    border-radius: var(--lg-radius-sm);
}

/* Wrapper per token; child is chip Button or inline TextField. */
.lg-error-spotting-slot {
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 4px;
    margin-bottom: 6px;
    flex-direction: row;
    align-items: center;
}

.lg-error-spotting-slot--marked {
    padding: 2px;
    border-radius: var(--lg-radius-sm);
    background-color: rgba(255, 200, 100, 0.12);
}

.lg-error-spotting-inline-field {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 48px;
    max-width: 220px;
    margin: 0;
    font-size: var(--lg-font-body);
    padding-left: var(--lg-space-4);
    padding-right: var(--lg-space-4);
}
