@import url("tokens-semantics.uss");

TextField > Label,
Label {
    color: var(--lg-text-main);
}

.lg-heading-display {
    font-size: var(--lg-font-display);
    -unity-font-style: bold;
    color: var(--lg-text-main);
    -unity-text-outline-width: 0;
}

.lg-heading-screen {
    font-size: var(--lg-font-h1);
    -unity-font-style: bold;
    letter-spacing: 0.2px;
}

.lg-text-h2 {
    font-size: var(--lg-font-h2);
}

.lg-text-body {
    font-size: var(--lg-font-body);
    white-space: normal;
}

.lg-text-body-lg {
    font-size: var(--lg-font-body-lg);
}

.lg-text-muted {
    color: var(--lg-text-soft);
}

.lg-text-caption {
    font-size: var(--lg-font-caption);
    color: var(--lg-text-muted);
}

.lg-fill-screen {
    flex-grow: 1;
    background-color: var(--lg-bg-app);
    flex-direction: column;
}

.lg-shell {
    padding: var(--lg-space-24);
    flex-grow: 1;
}

.lg-shell--narrow {
    max-width: 520px;
    align-self: center;
}

.lg-overlay-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.lg-muted-panel {
    background-color: var(--lg-bg-muted);
    border-radius: var(--lg-radius-md);
}

/* Clickable phrase chips for ErrorSpotting (`ErrorSpottingToolkitStep`). */
.lg-error-spotting-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    white-space: normal;
    margin-top: var(--lg-space-8);
}

.lg-error-spotting-chip {
    flex-grow: 0;
    border-width: 0;
    padding-left: var(--lg-space-4);
    padding-right: var(--lg-space-4);
    padding-top: 6px;
    padding-bottom: 6px;
    margin-right: 4px;
    margin-bottom: 6px;
    border-radius: var(--lg-radius-sm);
    background-color: transparent;
    font-size: var(--lg-font-body);
    color: var(--lg-text-main);
}

.lg-error-spotting-chip:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.lg-error-spotting-chip.lg-error-spotting-chip--marked {
    background-color: rgba(255, 200, 100, 0.18);
    border-radius: var(--lg-radius-sm);
}

.lg-error-spotting-corrections {
    margin-top: var(--lg-space-16);
    flex-direction: column;
}
