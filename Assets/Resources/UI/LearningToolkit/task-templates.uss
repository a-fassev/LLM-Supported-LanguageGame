@import url("tokens-semantics.uss");

/* Shared quest step template chrome (UI Builder–authored UXML under Templates/) */
.lg-task-template-root {
    flex-grow: 1;
    flex-direction: column;
    padding-top: var(--lg-space-12);
    padding-bottom: var(--lg-space-12);
    padding-left: var(--lg-space-16);
    padding-right: var(--lg-space-16);
}

/* Column layout when mounted in quest task shell (outer panel chrome lives on shell only). */
.lg-task-template-layout {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    padding-top: var(--lg-space-12);
    padding-bottom: var(--lg-space-12);
    padding-left: var(--lg-space-16);
    padding-right: var(--lg-space-16);
}

.lg-cloze-line-row {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    margin-bottom: var(--lg-space-12);
    overflow-x: auto;
}

.lg-cloze-line-row > Label {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
}

.lg-cloze-lines-host {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.lg-task-template-footer {
    flex-shrink: 0;
    margin-top: auto;
}

.lg-task-content-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* In-task copy: shell header already shows quest title — keep prompts body-sized. */
.lg-task-prompt {
    font-size: var(--lg-font-body);
    color: var(--lg-text-main);
    white-space: normal;
}

.lg-task-meta {
    font-size: var(--lg-font-body);
    color: var(--lg-text-soft);
    white-space: normal;
}

/* Special Screen host (quest shell already shows quest title). */
.lg-special-screen-host .lg-task-prompt,
.lg-special-screen-host .lg-task-meta {
    flex-shrink: 0;
}

.lg-scene-background-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.lg-quest-shell-root,
.lg-scene-bg-root {
    position: relative;
    flex-grow: 1;
    align-self: stretch;
    width: 100%;
    height: 100%;
}

/* Let GameArt USS / scene-background-host show through (not --lg-bg-app sand). */
.lg-scene-bg-root.lg-fill-screen {
    background-color: rgba(0, 0, 0, 0);
}

.lg-game-panel--over-scene {
    background-color: var(--lg-task-bg-over-scene);
}

.lg-drag-drop-root {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
}

.lg-drag-drop-bank-host {
    flex-shrink: 0;
}

.lg-drag-drop-targets-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.lg-matching-columns-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
}

.lg-matching-center-gap {
    width: 56px;
    flex-shrink: 0;
    flex-grow: 0;
    background-color: rgba(0, 0, 0, 0);
}

.lg-matching-left-column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
    flex-direction: column;
}

.lg-matching-right-column {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 8px;
    flex-direction: column;
}

.lg-matching-pairing-area {
    flex-grow: 1;
    min-height: 220px;
    position: relative;
}
