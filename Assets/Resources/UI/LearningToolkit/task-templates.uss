@import url("tokens-semantics.uss");

/* Shared quest step template chrome (UI Builder–authored UXML under Templates/) */
.lg-task-template-root {
    flex-grow: 1;
    flex-direction: column;
    padding-top: var(--lg-space-12);
    padding-bottom: var(--lg-space-12);
    padding-left: var(--lg-space-16);
    padding-right: var(--lg-space-16);
}

/* In-task copy: shell header already shows quest title — keep prompts body-sized. */
.lg-task-prompt {
    font-size: var(--lg-font-body);
    color: var(--lg-text-main);
    white-space: normal;
}

.lg-task-meta {
    font-size: var(--lg-font-body);
    color: var(--lg-text-soft);
    white-space: normal;
}

/* Special Screen host (quest shell already shows quest title). */
.lg-special-screen-host .lg-task-prompt,
.lg-special-screen-host .lg-task-meta {
    flex-shrink: 0;
}

.lg-scene-background-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.lg-quest-shell-root,
.lg-scene-bg-root {
    position: relative;
}

.lg-game-panel--over-scene {
    background-color: var(--lg-task-bg-over-scene);
}

.lg-matching-columns-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
}

.lg-matching-left-column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 16px;
    flex-direction: column;
}

.lg-matching-right-column {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 16px;
    flex-direction: column;
}

.lg-matching-pairing-area {
    flex-grow: 1;
    min-height: 220px;
    position: relative;
}
