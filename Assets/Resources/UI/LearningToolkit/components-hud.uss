@import url("tokens-semantics.uss");

/* HUD strip — horizontal badges; horizontal inset comes from parent shell */
.lg-hud-strip {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding-bottom: var(--lg-space-8);
}

.lg-hud-strip--in-header {
    flex-wrap: nowrap;
    padding-bottom: 0;
}

.lg-page-header #navigation-wallet-hud-part {
    flex-shrink: 0;
}

.lg-page-header #pause-menu-button {
    flex-shrink: 0;
}

/* Resource capsule: icon glyph + bold value */
.lg-hud-badge {
    flex-direction: row;
    align-items: center;
    background-color: var(--lg-hud-bg);
    border-radius: var(--lg-radius-button);
    border-width: var(--lg-stroke-2);
    border-color: var(--lg-hud-border);
    padding-left: var(--lg-space-12);
    padding-right: var(--lg-space-12);
    padding-top: var(--lg-space-4);
    padding-bottom: var(--lg-space-4);
    margin-right: var(--lg-space-8);
    margin-bottom: var(--lg-space-4);
}

.lg-hud-badge__icon {
    font-size: var(--lg-font-body-lg);
    margin-right: var(--lg-space-4);
    -unity-text-align: middle-center;
}

.lg-hud-badge__icon.lg-hud-badge__glyph--pizza {
    color: var(--lg-terra-520);
    -unity-font-style: bold;
}

.lg-hud-badge__icon.lg-hud-badge__glyph--backpack {
    color: var(--lg-peach-600);
    -unity-font-style: bold;
}

.lg-hud-badge__value {
    font-size: var(--lg-font-body);
    -unity-font-style: bold;
    color: var(--lg-text-main);
    -unity-text-align: middle-left;
}

.lg-hud-badge--pizza {
    border-color: var(--lg-terra-450);
}

.lg-hud-badge--backpack {
    border-color: var(--lg-peach-500);
}
