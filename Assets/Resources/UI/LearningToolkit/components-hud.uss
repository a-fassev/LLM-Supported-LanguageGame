@import url("tokens-semantics.uss");

/* HUD strip — horizontal badges; horizontal inset comes from parent shell */
.lg-hud-strip {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding-bottom: var(--lg-space-8);
}

/* Resource capsule: icon glyph + bold value */
.lg-hud-badge {
    flex-direction: row;
    align-items: center;
    background-color: var(--lg-hud-bg);
    border-radius: var(--lg-radius-pill);
    border-width: var(--lg-stroke-2);
    border-color: var(--lg-hud-border);
    border-top-color: var(--lg-hud-highlight);
    padding-left: var(--lg-space-12);
    padding-right: var(--lg-space-12);
    padding-top: var(--lg-space-4);
    padding-bottom: var(--lg-space-4);
    margin-right: var(--lg-space-8);
    margin-bottom: var(--lg-space-4);
}

.lg-hud-badge__icon {
    font-size: var(--lg-font-body-lg);
    margin-right: var(--lg-space-4);
    -unity-text-align: middle-center;
}

.lg-hud-badge__value {
    font-size: var(--lg-font-body);
    -unity-font-style: bold;
    color: var(--lg-text-main);
    -unity-text-align: middle-left;
}

.lg-hud-badge--pizza {
    border-color: var(--lg-terra-450);
    border-top-color: var(--lg-hud-highlight);
}

.lg-hud-badge--backpack {
    border-color: var(--lg-sea-500);
    border-top-color: var(--lg-hud-highlight);
}
