@import url("tokens-semantics.uss");

.lg-card {
    background-color: var(--lg-surface-1);
    border-radius: var(--lg-radius-lg);
    border-width: var(--lg-stroke-2);
    border-color: var(--lg-border-soft);
}

.lg-panel-padded {
    padding: var(--lg-space-24);
}

.lg-game-panel {
    background-color: var(--lg-task-bg);
    border-radius: var(--lg-radius-lg);
    border-width: var(--lg-stroke-2);
    border-color: var(--lg-task-border);
    border-top-color: var(--lg-card-highlight);
}

.lg-game-panel--hard {
    background-color: var(--lg-task-bg-hard);
    border-width: var(--lg-stroke-2);
    border-color: var(--lg-task-border-hard);
    border-top-color: var(--lg-card-highlight);
}

.lg-quest-step-panel {
    flex-grow: 1;
    flex-direction: column;
    flex-shrink: 1;
    min-height: 0;
    margin-top: var(--lg-space-12);
    padding: var(--lg-space-8);
}

.lg-quest-footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
    margin-top: auto;
    width: 100%;
}

/* Task shell: mirror cutscene column flex so step-host fills height and footer stays bottom. */
.lg-task-shell__column {
    flex-grow: 1;
    min-height: 0;
}

.lg-task-shell__stage {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.lg-task-shell__step-host {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
}

/* Cutscene shell: full-stage narrative (no task panel chrome). */
.lg-cut-shell__column {
    flex-grow: 1;
}

.lg-cut-shell__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    width: 100%;
    min-height: 44px;
}

.lg-cut-shell__stage {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.lg-cut-shell__step-host {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
}

.lg-cut-shell__footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
    width: 100%;
    margin-top: var(--lg-space-12);
}

.lg-list-scroll {
    flex-grow: 1;
}

.lg-leaderboard-rows-panel {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    align-self: stretch;
    margin-top: var(--lg-space-12);
}

.lg-leaderboard-scroll-host {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.lg-leaderboard-scroll-content,
.lg-leaderboard-list-host,
.lg-leaderboard-ui-builder-preview {
    flex-direction: column;
    flex-shrink: 0;
}

.lg-leaderboard-player-row {
    flex-direction: row;
    align-items: center;
    min-height: 72px;
    padding-left: var(--lg-space-16);
    padding-right: var(--lg-space-16);
    margin-bottom: var(--lg-space-12);
    background-color: var(--lg-surface-1);
    border-radius: var(--lg-radius-md);
    border-width: var(--lg-stroke-1);
    border-color: var(--lg-border-soft);
}

.lg-leaderboard-rows-panel .lg-leaderboard-player-row {
    margin-bottom: var(--lg-space-8);
}

.lg-leaderboard-team-dot {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    margin-right: var(--lg-space-8);
    border-radius: 50%;
    opacity: 0;
}

.lg-leaderboard-team-dot--visible {
    opacity: 1;
}

.lg-leaderboard-team-dot--blue {
    background-color: var(--lg-sea-500);
}

.lg-leaderboard-team-dot--red {
    background-color: var(--lg-terra-450);
}

.lg-leaderboard-player-row__rank {
    flex-shrink: 0;
    min-width: 36px;
}

.lg-leaderboard-player-row__name {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.lg-leaderboard-team-summary__info {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
}

.lg-leaderboard-team-summary__info .lg-leaderboard-player-row__name {
    flex-grow: 0;
    flex-shrink: 0;
}

.lg-leaderboard-team-summary__meta {
    flex-shrink: 0;
    margin-left: var(--lg-space-8);
}

.lg-leaderboard-wallet-stats {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.lg-leaderboard-wallet-badge {
    padding-left: var(--lg-space-8);
    padding-right: var(--lg-space-8);
    padding-top: var(--lg-space-4);
    padding-bottom: var(--lg-space-4);
    margin-right: var(--lg-space-8);
    margin-bottom: 0;
}

.lg-leaderboard-wallet-badge--trailing {
    margin-right: 0;
}

.lg-leaderboard-team--blue {
    border-left-width: 6px;
    border-left-color: var(--lg-sea-500);
}

.lg-leaderboard-team--red {
    border-left-width: 6px;
    border-left-color: var(--lg-terra-450);
}

.lg-leaderboard-team-section-header {
    margin-top: var(--lg-space-8);
    margin-bottom: var(--lg-space-4);
}

.lg-list-row {
    margin-bottom: var(--lg-space-12);
}

Button.lg-list-row-button {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 72px;
    padding-left: var(--lg-space-16);
    padding-right: var(--lg-space-16);
    margin-bottom: var(--lg-space-12);
    background-color: var(--lg-surface-1);
    border-radius: var(--lg-radius-md);
    border-width: var(--lg-stroke-1);
    border-color: var(--lg-border-soft);
    color: var(--lg-text-main);
    -unity-text-align: middle-left;
}

Button.lg-list-row-button:hover {
    background-color: var(--lg-surface-2);
}

Button.lg-list-row-button:active {
    background-color: var(--lg-surface-2);
    padding-left: 18px;
}

Button.lg-list-row-button > Label.lg-list-row-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

Button.lg-list-row-button > Label.lg-chip {
    flex-grow: 0;
    flex-shrink: 0;
}

.lg-chip {
    flex-shrink: 0;
    border-radius: var(--lg-radius-button);
    padding-left: var(--lg-space-12);
    padding-right: var(--lg-space-12);
    padding-top: var(--lg-space-4);
    padding-bottom: var(--lg-space-4);
    margin-left: var(--lg-space-12);
}

.lg-chip--new {
    background-color: var(--lg-chip-new-bg);
}

.lg-chip--bonus {
    background-color: var(--lg-chip-bonus-bg);
}

.lg-chip--lock {
    background-color: var(--lg-feedback-guidance-bg);
    color: var(--lg-guidance);
}
