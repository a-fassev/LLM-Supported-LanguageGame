NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Use exact ids from GET /v1/models with your key (some models 404 if not enabled on your account).
NVIDIA_EVAL_MODEL=minimaxai/minimax-m2.7
LLM_TASK_TIMEOUT_MS=12000
LLM_TASK_MAX_RETRIES=1
# Optional; when set, POST /api/tasks/evaluate requires header x-task-eval-api-key with the same value.
TASK_EVAL_API_KEY=

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=npc-chat-kpi
