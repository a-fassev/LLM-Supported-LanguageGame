# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-only Secret API key (sb_secret_...). Bypasses RLS — never NEXT_PUBLIC_, never commit, never ship to Unity.
# If leaked: rotate in dashboard (Secret API keys) immediately.
SUPABASE_SECRET_KEY=your_sb_secret_key

# Optional: only if browser/client code calls Supabase directly (safe to expose).
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: comma-separated origins for CORS and Next.js dev LAN access (allowedDevOrigins).
# Required when testing on iPad/phone via http://192.168.x.x:3000 — restart dev server after change.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.178.107:3000

# Smoke walkthrough: skip task evaluation (including free_text LLM) and award full pizza (local/staging only; never production).
# GAME_SMOKE_AUTO_PASS=true

# --- FreitextLlm scorer (LangChain ChatGoogle -> Google AI Studio Gemini API) ---
# Configure only in .env.local during development (never commit).
# Use one AI Studio project per key to multiply free-tier RPM/RPD quotas.
# GEMINI_API_KEY_1=your_google_ai_studio_api_key
# GEMINI_API_KEY_2=optional_second_project_key
# GEMINI_API_KEY_3=optional_third_project_key
# GEMINI_API_KEY_4=optional_fourth_project_key
# GEMINI_EVAL_MODEL=gemini-3.5-flash
# LLM_TASK_TIMEOUT_MS=45000
# LLM_TASK_MAX_RETRIES=2
